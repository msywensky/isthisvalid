# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all local secrets but keep the example template
.env*
!.env.example
# apps/mobile's EXPO_PUBLIC_* files hold no secrets (build-time public
# constants only, per Expo convention) — commit them like .env.example.
!apps/mobile/.env.development
!apps/mobile/.env.production

# vercel
.vercel

# expo (apps/mobile has its own .gitignore too, but `npx expo lint` run
# from the repo root — instead of apps/mobile — creates this at the root)
.expo/

# typescript
*.tsbuildinfo
next-env.d.ts

# my personal files
notes.txt
prompts.txt
ROADMAP.md
LAUNCH.md
handoff-*.md
